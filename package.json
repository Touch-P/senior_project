{
  "name": "smart-cart",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Cart: real-time YOLO cart detection backend (Node.js + SQLite) and admin/customer web UI",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node scripts/doctor.js",
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "test": "node --test \"server/test/**/*.test.js\"",
    "db:init": "node server/src/db/migrate.js",
    "db:seed": "node server/src/db/seed.js",
    "export:feedback": "node server/src/jobs/exportFeedback.js",
    "export:latency": "node server/src/jobs/exportLatency.js",
    "db:erd": "node scripts/erd.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
