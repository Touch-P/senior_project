# Copy to .env and change the secrets. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info
# JSON log file (also printed to the terminal); empty = terminal only
LOG_FILE=logs/server.log

# HTTPS server (phone camera needs a secure context).
# Without TLS_CERT/TLS_KEY files, development mode falls back to plain HTTP on 127.0.0.1 only.
PORT=8443
HTTP_REDIRECT_PORT=8080
HOST=0.0.0.0
# Public https origin used in phone camera links/QR (e.g. https://xxxx.trycloudflare.com from cloudflared).
# Empty = https://<LAN IP>:PORT when the certificate exists. See docs/phone-camera.md.
PUBLIC_URL=
TLS_CERT=certs/lan.pem
TLS_KEY=certs/lan-key.pem

# SQLite
DB_PATH=db/smartcart.db

# Inference: real = call Python service, mock = replay server/test/scenarios/*.json
INFERENCE_MODE=real
INFERENCE_URL=http://127.0.0.1:8001
INFERENCE_TIMEOUT_MS=2000
# mock only: play this scenario on every cart (empty = the cart's own scenario, else the default one)
MOCK_SCENARIO=
# mock only: simulated inference time per frame (ms)
MOCK_LATENCY_MS=0
# Folder holding the benchmark runs (read-only); model_versions.weights_path is relative to it
WEIGHTS_ROOT=C:/Users/Acer/Desktop/SNP
# Weights loaded by inference/ at start (read-only). Node.js then switches it to the model active in the DB.
MODEL_PATH=C:/Users/Acer/Desktop/SNP/yolov11/outputv11/yolo11s-s0-20261025/weights/best.pt
# inference/ only: auto | cpu | cuda:0, input size, minimum confidence returned (Node.js filters with CONF_THRESHOLD)
INFER_DEVICE=auto
INFER_IMGSZ=640
INFER_CONF=0.25

# Pipeline
# frames waiting per cart before the oldest is dropped; parallel calls to inference (GPU: start with 1)
FRAME_QUEUE_MAX=2
INFER_CONCURRENCY=1
# batch commit of frame/detection rows; throttle of live_update to the dashboard
WRITER_FLUSH_MS=1000
LIVE_THROTTLE_MS=250
# alerts: camera silent during a session, server p95 limit, inference errors in a row
DISCONNECT_MS=30000
HIGH_LATENCY_MS=300
INFERENCE_DOWN_AFTER=5
# JPEGs kept only for frames with events / customer reports
FRAMES_DIR=data/frames

# Batch jobs: on = scheduled in the server (timeout every minute, analytics 02:00, backup 02:30, retention Sun 03:00)
JOBS=on
# active session with no frame / event for this long -> timeout (items) or abandoned (empty)
SESSION_IDLE_MS=1800000
RETENTION_DAYS=30
BACKUP_DIR=db/backups
BACKUP_KEEP=7
EXPORT_DIR=exports

# Tracker / reason engine
# frame | window | bytetrack  (RQ4: (a) per frame, (b) sliding window + hysteresis, (c) ByteTrack IDs)
TRACKER_MODE=window
# true = presence state machine + exit evidence + reasons (brief 7); false = every stable-count change is ADD/REMOVE
PRESENCE_RULES=true
CONF_THRESHOLD=0.70
TRACKER_WINDOW=8
TRACKER_ADD_K=3
# W / K are frames at this rate; a cart streaming faster scales them by round(fps / 4): 30 fps -> W=64, K=24 (same seconds)
TRACKER_REF_FPS=4
REASON_PAIR_WINDOW_MS=60000

# Bootstrap admin account (password is hashed with bcrypt on seed)
ADMIN_EMAIL=admin@smartcart.co.th
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me
# Admin login: lock the account after N wrong passwords; session lifetime
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_MS=300000
SESSION_TTL_MS=43200000
SESSION_REMEMBER_MS=604800000
# Demo staff account, created only when NODE_ENV=development
DEV_STAFF_PASSWORD=staff1234
